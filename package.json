{
  "name": "@hraness/posthog",
  "version": "0.1.1",
  "description": "Privacy-preserving PostHog analytics primitives for modern web applications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/posthog.git"
  },
  "homepage": "https://github.com/hraness/posthog#readme",
  "bugs": {
    "url": "https://github.com/hraness/posthog/issues"
  },
  "keywords": [
    "analytics",
    "nextjs",
    "posthog",
    "privacy"
  ],
  "exports": {
    ".": {
      "types": "./src/site.ts",
      "import": "./dist/site.js",
      "default": "./dist/site.js"
    },
    "./site": {
      "types": "./src/site.ts",
      "import": "./dist/site.js",
      "default": "./dist/site.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./event": {
      "types": "./src/event.ts",
      "import": "./dist/event.js",
      "default": "./dist/event.js"
    },
    "./next-config": {
      "types": "./src/next-config.ts",
      "import": "./dist/next-config.js",
      "default": "./dist/next-config.js"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./traffic": {
      "types": "./src/traffic.ts",
      "import": "./dist/traffic.js",
      "default": "./dist/traffic.js"
    }
  },
  "main": "./dist/site.js",
  "types": "./src/site.ts",
  "files": [
    "dist",
    "src/client.ts",
    "src/event.ts",
    "src/next-config.ts",
    "src/react.tsx",
    "src/server.ts",
    "src/site.ts",
    "src/traffic.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "kb:refresh": "bunx --bun github:hraness/kb#v0.15.1 refresh --root kb",
    "kb:check:lane": "bunx --bun github:hraness/kb#v0.15.1 check --root kb --no-catalog",
    "kb:check": "bunx --bun github:hraness/kb#v0.15.1 check --root kb && bunx --bun github:hraness/kb#v0.15.1 agents check --root kb --repo .",
    "kb:catalog": "bunx --bun github:hraness/kb#v0.15.1 catalog --root kb",
    "build": "bun run ./scripts/build.ts",
    "check:boundaries": "bun run ./scripts/check-bundle-boundaries.ts",
    "check:portfolio-inventory": "bun run ./scripts/check-portfolio-inventory.ts",
    "check:public-boundary": "bun run ./scripts/check-public-boundary.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:property": "bun test ./src/*.property.test.ts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check": "bun run check:portfolio-inventory && bun run check:public-boundary && bun run lint && bun run typecheck && bun run build && bun run check:boundaries && bun run test && bun run test:property && bun run test:package && bun run kb:check",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@posthog/nextjs-config": "1.9.68",
    "posthog-js": "1.412.1",
    "posthog-node": "5.47.11"
  },
  "peerDependencies": {
    "next": ">=16.2.0 <17.0.0",
    "react": ">=19.2.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "fast-check": "^4.8.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.53.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
