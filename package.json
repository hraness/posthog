{
  "name": "@hraness/posthog",
  "version": "0.3.1",
  "description": "Cookieless PostHog analytics for Next.js, limited to the hosts, routes, and events your site declares, plus server error reporting and production source-map upload.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/posthog.git"
  },
  "homepage": "https://github.com/hraness/posthog#readme",
  "bugs": {
    "url": "https://github.com/hraness/posthog/issues"
  },
  "keywords": [
    "analytics",
    "cookieless",
    "nextjs",
    "posthog",
    "privacy",
    "source-maps"
  ],
  "exports": {
    ".": {
      "types": "./src/site.ts",
      "import": "./dist/site.js",
      "default": "./dist/site.js"
    },
    "./site": {
      "types": "./src/site.ts",
      "import": "./dist/site.js",
      "default": "./dist/site.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./event": {
      "types": "./src/event.ts",
      "import": "./dist/event.js",
      "default": "./dist/event.js"
    },
    "./next-config": {
      "types": "./src/next-config.ts",
      "import": "./dist/next-config.js",
      "default": "./dist/next-config.js"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./traffic": {
      "types": "./src/traffic.ts",
      "import": "./dist/traffic.js",
      "default": "./dist/traffic.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "main": "./dist/site.js",
  "types": "./src/site.ts",
  "files": [
    "dist",
    "src/client.ts",
    "src/consent.ts",
    "src/event.ts",
    "src/next-config.ts",
    "src/react.tsx",
    "src/server.ts",
    "src/site.ts",
    "src/traffic.ts",
    "src/testing-harness.ts",
    "src/testing.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "kb:refresh": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell refresh --root kb",
    "kb:check:lane": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb --no-catalog",
    "kb:check": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb && bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell agents check --root kb --repo .",
    "kb:catalog": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell catalog --root kb",
    "kb:search": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell search --root kb --mode exact --selected-passage",
    "build": "bun run ./scripts/build.ts",
    "check:boundaries": "bun run ./scripts/check-bundle-boundaries.ts",
    "check:portfolio-inventory": "bun run ./scripts/check-portfolio-inventory.ts",
    "check:product-contract": "bun run ./scripts/check-product-contract.ts",
    "check:public-boundary": "bun run ./scripts/check-public-boundary.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:property": "bun test ./src/*.property.test.ts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check:code": "bun run check:portfolio-inventory && bun run check:product-contract && bun run check:public-boundary && bun run lint && bun run typecheck && bun run build && bun run check:boundaries && bun run test && bun run test:property && bun run test:package",
    "check": "bun run check:code && bun run kb:check",
    "prepack": "bun run check"
  },
  "dependencies": {
    "@posthog/nextjs-config": "1.10.0",
    "posthog-js": "1.422.5",
    "posthog-node": "5.51.4"
  },
  "peerDependencies": {
    "next": ">=16.2.0 <17.0.0",
    "react": ">=19.2.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.2",
    "fast-check": "^4.8.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
