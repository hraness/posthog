{
  "name": "@hraness/analytics",
  "version": "1.2.2",
  "description": "One PostHog analytics standard for websites, docs, web apps, Workers, CLIs and Mac apps: a region policy, consent banner, first-touch attribution, Meta Pixel and Conversions API gates, server capture and opt-out CLI telemetry.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/posthog.git"
  },
  "homepage": "https://github.com/hraness/posthog#readme",
  "bugs": {
    "url": "https://github.com/hraness/posthog/issues"
  },
  "keywords": [
    "analytics",
    "attribution",
    "consent",
    "gpc",
    "posthog",
    "privacy",
    "telemetry"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./src/policy.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./events": {
      "types": "./src/events.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./attribution": {
      "types": "./src/attribution.ts",
      "import": "./dist/attribution.js",
      "default": "./dist/attribution.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./experiment": {
      "types": "./src/experiment.ts",
      "import": "./dist/experiment.js",
      "default": "./dist/experiment.js"
    },
    "./meta": {
      "types": "./src/meta.ts",
      "import": "./dist/meta.js",
      "default": "./dist/meta.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src/*.ts",
    "!src/*.test.ts",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "kb:refresh": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell refresh --root kb",
    "kb:check:lane": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell check --root kb --no-catalog",
    "kb:check": "bun .github/wordcell/check.ts check --root kb && bun .github/wordcell/check.ts agents check --root kb --repo .",
    "kb:catalog": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell catalog --root kb",
    "kb:search": "bunx --bun --package https://github.com/hraness/wordcell/releases/download/v0.24.0/hraness-wordcell-0.24.0.tgz wordcell search --root kb --mode exact --selected-passage",
    "build": "bun run ./scripts/build.ts",
    "check:boundaries": "bun run ./scripts/check-bundle-boundaries.ts",
    "check:portfolio-inventory": "bun run ./scripts/check-portfolio-inventory.ts",
    "check:product-contract": "bun run ./scripts/check-product-contract.ts",
    "check:public-boundary": "bun run ./scripts/check-public-boundary.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:property": "bun test ./src/*.property.test.ts",
    "test:package": "bun run ./scripts/package-smoke.ts",
    "check:code": "bun run check:portfolio-inventory && bun run check:product-contract && bun run check:public-boundary && bun run check:swift-policy && bun run check:experiment-source && bun run lint && bun run typecheck && bun run build && bun run check:boundaries && bun run test && bun run test:property && bun run test:package",
    "check": "bun run check:code && bun run kb:check",
    "prepack": "bun run check",
    "check:swift-policy": "bun run ./scripts/generate-swift-policy.ts --check",
    "swift:policy": "bun run ./scripts/generate-swift-policy.ts",
    "check:experiment-source": "bun run ./scripts/generate-experiment-source.ts --check",
    "experiment:source": "bun run ./scripts/generate-experiment-source.ts"
  },
  "dependencies": {
    "posthog-js": "1.449.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.2",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
